{
	"compilerOptions": {
		"target": "ES2022",
		/*
		 * Browser libs + `vite/client` look wrong for a "node" project, but
		 * `ssg/routes.ts` and `ssg/sitemap.ts` import `@/lib/*`, which transitively
		 * pulls most of `src/` (down to `.tsx` components, `import.meta.env`,
		 * `?url`/imagetools asset imports) into this project. These settings —
		 * including `strict: false` below — mirror tsconfig.app.json so the shared
		 * files typecheck identically in both projects.
		 */
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "node"],
		"module": "ESNext",
		"skipLibCheck": true,
		"jsx": "react-jsx",

		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"noEmit": true,

		/* Path aliases */
		"paths": {
			"@/*": ["./src/*"]
		},

		/* Linting */
		"strict": false,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noFallthroughCasesInSwitch": true
	},
	/* `src/*.d.ts`: ambient decls for `.mdx` and imagetools `?w=…&as=picture`
	 * imports, needed by the `src/` files reachable from `ssg/`. */
	"include": ["vite.config.ts", "ssg", "src/*.d.ts"]
}
