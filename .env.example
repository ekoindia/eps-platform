# ---------------------------------------------------------------------------
# Public UAT demo keypair for the /docs "Test Request" dialog.
#
# Copy to `.env.local` (gitignored):  cp .env.example .env.local
#
# These are prefilled into the dialog's Authentication section (in production
# builds too — this is a deliberately public, quota'd demo credential; see
# src/lib/uat-credentials.ts). The access_key is only ever an input to the
# in-browser HMAC (src/lib/docs/eko-signing.ts) computed when Send is pressed;
# it is never stored and never sent anywhere. Leave blank to make users type
# their own keys.
# ---------------------------------------------------------------------------

# Eko UAT/sandbox developer_key (static API key issued after signup)
VITE_EPS_UAT_DEVELOPER_KEY=

# Eko UAT/sandbox access_key (in-browser HMAC signing only)
VITE_EPS_UAT_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Try-it proxy. The Eko API hosts send no CORS headers, so the dialog POSTs to
# eps-backend's `POST /tryit/proxy` (same-origin `/api` on Vercel, see
# vercel.json `routes`). Defaults to `<VITE_EPS_BACKEND_URL or /api>/tryit/proxy`;
# set this only to point at a different backend origin.
# ---------------------------------------------------------------------------
# VITE_TRYIT_PROXY_URL=/api/tryit/proxy

# EPS Console auth UI
# Show the user Log in / Console entry points (header + footer). Also switches the primary
# "Get Started" CTA (header, Products mega-menu, pricing calculators) from the Zoho chat to
# /console. Keep false in prod until tested.
VITE_SHOW_USER_LOGIN=false

# EPS Transactional MCP marketing
# Split the "AI" nav into "Build with AI" + "For AI agents" and prerender/index
# the /agents page. Keep false until eps-transact-mcp is live in production and
# smoke-tested. Off = single "AI Agents" link; /agents stays an unindexed preview.
VITE_SHOW_TRANSACT_MCP=false

# Optional override for the eps-backend base URL. Defaults to same-origin "/api".
#
# The "/api" default only works where something actually SERVES /api: in dev the
# Vite proxy does (see vite.config.ts), and in production a host rewrite would.
# With neither, /api/me hits the SPA fallback and returns index.html with a 200.
#
# Two ways to point production at the backend, preferred first:
#   1. A same-origin proxy, leaving this UNSET. On Vercel that is a `routes`
#      entry (not `rewrites` — only `routes` can expand an env var, keeping the
#      backend hostname out of the repo):
#        { "src": "/api/(.*)", "dest": "${EPS_BACKEND_ORIGIN}/$1",
#          "env": ["EPS_BACKEND_ORIGIN"] }
#      with EPS_BACKEND_ORIGIN set as a Vercel project env var. Cookies stay
#      first-party, so no CORS and no SameSite=None. Full walkthrough:
#      packages/eps-backend/docs/eps-backend-vm-deploy.md (Step 10).
#   2. Set this to the absolute origin (https://api.eps.eko.in). Then the backend
#      MUST send Access-Control-Allow-Origin for the site origin plus
#      Access-Control-Allow-Credentials: true, answer preflight OPTIONS, and
#      issue cookies that survive the cross-site hop.
# VITE_EPS_BACKEND_URL=/api

# Dev-only: where the Vite /api proxy forwards (defaults to http://localhost:8787).
# VITE_DEV_BACKEND_ORIGIN=http://localhost:8787

# Eko Connect widget (embedded transaction flows in the console)
# Origin serving the widget bundle. MUST match the environment the backend's
# CONNECT_API_BASE_URL points at — the widget's API host is baked into its own
# bundle, so a beta widget against a prod backend spends the wrong token.
# VITE_CONNECT_WIDGET_URL=https://beta.ekoconnect.in
#
# Show the "＋" Load-Balance button and mount /console/transaction/:id.
# Keep false until connect-api's CORS allowlist includes this origin.
VITE_SHOW_CONNECT_WIDGET=false

# ekostore handoff (the rail's "Test KYC & Verification APIs" link)
# Origin of the ekostore app. Unset or blank → https://ekostore.app. Point at a
# beta ekostore ONLY when it is backed by the same connect-api as this
# environment: the link carries a live access token.
# VITE_EKOSTORE_URL=https://ekostore.app

# Business Dashboard (the widgets on /console, below the Next Steps card)
# Keep false until the numbers are reconciled against Eloka for a real account —
# see the status banner in docs/features/business-dashboard.md. With it off,
# nothing on Home calls /dashboard at all.
VITE_SHOW_BUSINESS_DASHBOARD=false
#
# Offer "Last 365 Days" in the dashboard's window picker. LOCAL TESTING ONLY:
# a year of upstream aggregation is slow and expensive, and production caps the
# range at 30 days. Hides the control only — the backend still serves last365.
VITE_SHOW_DASHBOARD_LAST_365=false
#
# Notifications (header bell + /console card, polled every 10 minutes)
# Keep false until interaction 10010 has been checked on production connect-api
# for a REAL developer account: the feed is Eko's shared EMS and today's copy is
# written for Eloka's retailers. With it off, nothing calls /notifications.
VITE_SHOW_NOTIFICATIONS=false

# Show the "Ask AI" row in the ⌘K palette for signed-in developers, opening the
# grounded docs assistant. Build-time only, and NOT the real gate: the backend
# decides, answering 503 CHAT_DISABLED unless EPS_CHAT_PROVIDER + EPS_CHAT_API_KEY
# are set there. Keep the two in step — with this on and the backend unset, the
# row shows until the first ask, which then hides it for the session.
VITE_SHOW_AI_CHAT=false

# Support contact strip (bottom of /console)
# Each channel is independent and OPTIONAL: unset or blank hides that one, and
# with all three unset the strip does not render at all — there is no separate
# SHOW_ flag. Phone and WhatsApp are NUMBERS, not links: the console builds
# tel: and https://wa.me/<digits> from them, so any punctuation is fine.
# See docs/features/support-contact.md.
# VITE_SUPPORT_EMAIL=
# VITE_SUPPORT_PHONE=
# VITE_SUPPORT_WHATSAPP=
