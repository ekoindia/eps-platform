<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>in.eko</groupId>
  <artifactId>eps-sdk</artifactId>
  <!-- Placeholder. The git tag is the version: JitPack builds from the tag and
       serves it as com.github.ekoindia:eps-sdk-java:vX.Y.Z regardless of what
       is written here, exactly as Packagist and the Go proxy do. -->
  <version>0.0.0</version>
  <packaging>jar</packaging>

  <name>EPS Java SDK</name>
  <description>Backend-only Java SDK for Eko Platform Services (EPS) APIs, with request signing built in.</description>
  <url>https://eps.eko.in/docs/sdk/java</url>

  <licenses>
    <license>
      <name>MIT</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <organization>
    <name>Eko Bharat Ventures Pvt Ltd</name>
    <url>https://eko.in</url>
  </organization>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- Java has no JSON in the standard library. Gson is the smallest option
         with no transitive dependencies of its own; the other three SDKs stay
         dependency-free because their languages ship a JSON parser. -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.11.0</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- data/sdk-surface.json is generated by scripts/bake-surface.mjs and
           gitignored; packaging it from there keeps one bake script for every
           SDK language. It lands at the classpath root. -->
      <resource>
        <directory>data</directory>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
</project>
