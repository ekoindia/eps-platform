# Service
PORT=8787
JWT_SECRET=change-me-to-a-32+char-random-string
ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=2592000
COOKIE_SECURE=true
# SameSite for the eps_at / eps_rt session cookies (default Lax). "None" also
# needs COOKIE_SECURE=true, or browsers drop the cookie and every login "expires".
# COOKIE_SAMESITE=Lax
CORS_ORIGINS=https://eps.eko.in
# DEV/UAT ONLY — echo the OTP back from /auth/otp/start (frontend shows a
# "Demo OTP" toast) so testing needs no SMS. Only UAT's upstream returns one.
# NEVER true in production: it hands anyone a login code for any mobile number.
DEMO_OTP=false
# LOCAL DEV ONLY. Adds POST /auth/admin/dev-login and a "Demo admin login" button
# on /admin (vite dev only): an admin session with no GitHub OAuth. Refuses to
# boot unless COOKIE_SECURE=false and NODE_ENV is not production; answers only
# loopback, unproxied, loopback-Origin requests. No GitHub token, so doc
# propose/deploy fail with NO_GH_TOKEN. See README "Local dev (GitHub OAuth)".
# DEV_ADMIN_LOGIN=true

# Auth provider — who answers the OTP/login exchange.
# UNSET (default): call SimpliBank interactions 515/518/151 directly.
# SET: delegate login to Eloka's connect-api so both products share one
# identity. connect-api's tokens are held server-side (sealed in KV at
# ca:<sid>); the browser still only ever sees this service's HttpOnly cookies.
# Server-to-server, so this app needs no entry in connect-api's ACCESS_ORIGINS.
# This is a CONFIGURATION fallback, not an availability one — the provider is
# chosen at boot, so a connect-api outage does not fail over. Must be https
# unless the host is loopback.
# CONNECT_API_BASE_URL=https://api.beta.ekoconnect.in
# Local dev against a connect-api on port 8001:
# CONNECT_API_BASE_URL=http://127.0.0.1:8001
# The connect-api org to authenticate against, and the org a profile must
# belong to for a developer session. 1 = Eko.
CONNECT_ORG_ID=1
CONNECT_API_TIMEOUT_MS=15000

# Eko backend (SimpliBank) — internal API
SIMPLIBANK_API_HOST=
SIMPLIBANK_API_PORT=
SIMPLIBANK_API_PATH=
# Upstream for interaction 154 (transaction history), which runs on its own box
# and an older API version. Each part is optional and falls back to the
# SIMPLIBANK_API_* value above, so a shared box only needs the path.
# connect-api routes 154 the same way (utils/url.js:70-99).
SIMPLIBANK_HISTORY_API_PATH=/ekoicici/v1/request
# SIMPLIBANK_HISTORY_API_HOST=10.100.10.9
# SIMPLIBANK_HISTORY_API_PORT=8080
# Inherits SIMPLIBANK_API_SCHEME; an http history host still needs
# SIMPLIBANK_ALLOW_INSECURE_HTTP=true unless it is loopback.
# SIMPLIBANK_HISTORY_API_SCHEME=http
SIMPLIBANK_API_SCHEME=https
# Set true only for a trusted private-network upstream that is HTTP-only
SIMPLIBANK_ALLOW_INSECURE_HTTP=false
EKO_DEVELOPER_KEY=
EKO_INITIATOR_ID=1234567891
EKO_USER_CODE=99029899
EKO_DEFAULT_ORG_ID=1
# Abort for direct SimpliBank calls. UAT answers interaction 151 in 10-11s, so a
# 10s ceiling turns a slow-but-fine profile read into a 502 on /me.
SIMPLIBANK_API_TIMEOUT_MS=30000
# Verbosity of the upstream request/response log (Eko/SimpliBank calls):
#   off   — log nothing
#   basic — metadata + masked mobile + response status/message (no OTP/creds); prod-safe (default)
#   full  — complete request (incl OTP) + full response body; DEV DEBUGGING ONLY
EKO_LOG_LEVEL=basic
# The build this process reports on the `x-eps-version` response header and in
# the error envelope's `version`. Falls back to "dev" when unset. Stamp it at
# image build time — `docker build --build-arg EPS_VERSION=$(git rev-parse
# --short HEAD)` — so "is production running this code?" is answerable from a
# screenshot rather than from the deploy poller's state.
# EPS_VERSION=
# DEV/UAT ONLY — skip the EPS-business-partner gate (org 1 / user_type 23) so any
# authenticated Eloka user (retailer, distributor, agent) can log into the
# console. For testing with existing test mobiles.
# NEVER true in production: it opens the developer portal to the whole Eloka base.
# DEV_ALLOW_ANY_USER_TYPE=false

# GitHub OAuth (admin)
# Create an OAuth App at https://github.com/settings/developers (OAuth Apps →
# New OAuth App; org-owned: Org → Settings → Developer settings → OAuth Apps).
# Copy the Client ID; "Generate a new client secret" for the secret (shown once).
# The App's "Authorization callback URL" must EXACTLY match GITHUB_CALLBACK_URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://eps.eko.in/api/auth/admin/github/callback
# Local dev (via the Vite :8080 proxy — see README "Local dev (GitHub OAuth)"):
# GITHUB_CALLBACK_URL=http://localhost:8080/api/auth/admin/github/callback
GITHUB_REPO=ekoindia/eps-platform
# Branch the admin console commits doc edits to (PR base); deploy promotes editBase -> prodBase.
GITHUB_EDIT_BASE=dev
GITHUB_PROD_BASE=main
# Admin refresh-token (and stored GitHub token) lifetime, seconds (default 28800 = 8h).
# Shorter than REFRESH_TTL_SEC on purpose: admin sessions can open PRs and deploy.
# ADMIN_REFRESH_TTL_SEC=28800
# Where the GitHub OAuth callback lands the admin (default /admin).
# ADMIN_POST_LOGIN_REDIRECT=/admin

# --- Zoho CRM ---
# Off = lead enrichment on the login path answers "not a lead", and the
# /crm/lead routes answer a named 404. On = the three credentials below are
# REQUIRED and a boot with any of them missing fails loudly, because the
# alternative (booting fine and failing every CRM call silently) is invisible.
ZOHO_ENABLED=false
# OAuth refresh-token grant. Generate the refresh token once — the steps are in
# eko-business-dashboard/docs/zoho-crm-funnel.md. Scope needed for BOTH reading
# and writing a Lead: ZohoCRM.modules.leads.ALL (a READ-only token 401s on
# PATCH /crm/lead). Secrets — never ship to the browser.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# REST API host for the data centre this org lives in (.in default; .com US,
# .eu EU). NOT a record URL — see ZOHO_CRM_RECORD_BASE_URL below.
# ZOHO_BASE_URL=https://www.zohoapis.in
# OAuth accounts host. Derived from ZOHO_BASE_URL (zohoapis.in ->
# accounts.zoho.in) unless set; set it for a custom domain or a data centre
# that breaks the pattern.
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
# Base of a CRM RECORD url in the Zoho web app, including the org segment.
# Used to link a partner's Lead/Contact from the activation-fee mail so finance
# can open the record instead of searching for it.
# NOT the same as ZOHO_BASE_URL above, which is the REST API host — the two
# differ by host AND path, and swapping them produces links that 404.
# Unset = the links are simply omitted (the row still renders). https only; a
# malformed value fails at boot rather than mailing dead links.
# ZOHO_CRM_RECORD_BASE_URL=https://crm.zoho.in/crm/org1234567890

# --- Production VM deploy (docker-compose.prod.yml) ---
# REDIS_URL=redis://redis:6379          # set in prod; requires KV_ENCRYPTION_KEY
# KV_ENCRYPTION_KEY=<base64 32 bytes>   # STABLE secret — never rotate via redeploy
# REDIS_TLS_REJECT_UNAUTHORIZED=true     # default true; false ONLY for a managed Redis with a self-signed cert
# POLLER_ALERT_WEBHOOK=                 # optional; poller POSTs deploy/rollback alerts here
# ANALYTICS_DB_PATH=/var/lib/eps-analytics/search-logs.db  # ⌘K search logs (SQLite).
#   Prod sets this in docker-compose.prod.yml beside its volume; unset = in-memory,
#   emptied on every restart. Local dev: set e.g. /tmp/eps-search-logs.db (outside
#   the repo) so logs survive `backend:dev` watch restarts. See "Search logs" in README.md.

# --- One-time activation-fee intimation (POST /activation-fee/intimate) ---
# The n8n webhook that mails Team Eko when a partner reports paying their
# one-time API activation fee by bank transfer. UNSET = the route still mounts
# but answers 503 ACTIVATION_FEE_DISABLED, so the console page explains itself
# instead of 404-ing. Must be https unless the host is loopback: partner PAN,
# GST and payment references travel over this connection, and the URL itself is
# a secret (an unauthenticated endpoint that mails staff) — it must never reach
# the browser bundle.
# NOTE: an n8n `/webhook-test/...` URL only fires while the workflow editor is
# open and listening. Use it for local testing ONLY; production needs the
# `/webhook/...` production URL, or every intimation is silently dropped.
# ACTIVATION_FEE_WEBHOOK_URL=https://automaton8n.eko.in/webhook/<id>
# Who gets told about a partner's payment. REQUIRED whenever the webhook above
# is set — there is deliberately no default in code, so no deployment can keep
# mailing whoever happened to be on the team when this was written.
# Comma-separated; an empty or malformed list is a boot error, not a silent
# no-op that drops every intimation.
# ACTIVATION_FEE_RECIPIENTS=eps@eko.in
# ACTIVATION_FEE_TIMEOUT_MS=20000

# --- AI docs-chat (POST /chat/ask) — see docs/docs-chat-agent.md ---
# Opt-in: with EPS_CHAT_* unset the route answers 503 CHAT_DISABLED. Also needs
# CONTEXT_BUNDLE_URL (below): the assistant only answers grounded in the bundle.
# PROVIDER and API_KEY must be set together, or boot fails. Frontend flag:
# VITE_SHOW_AI_CHAT in the site's .env.example — keep the two in step.
# EPS_CHAT_PROVIDER=anthropic            # anthropic | openai | openrouter
# EPS_CHAT_API_KEY=                      # secret — provider key
# EPS_CHAT_MODEL=claude-haiku-4-5        # default claude-haiku-4-5
# EPS_CHAT_BASE_URL=                     # optional override; must be https unless loopback
# Monthly spend cap in USD (default 0 = NO cap). When > 0, both prices below are
# required (USD per million tokens), or boot fails — an unenforceable cap is
# worse than an obviously absent one.
# Example values only — copy the current per-MTok prices from the provider's
# pricing page for the model you set.
# EPS_CHAT_MONTHLY_BUDGET_USD=20
# EPS_CHAT_PRICE_INPUT_PER_MTOK=<usd per 1M input tokens>
# EPS_CHAT_PRICE_OUTPUT_PER_MTOK=<usd per 1M output tokens>

# --- Hosted context MCP server (/context/*, public + anonymous) ---
# Set to mount @ekoindia/eps-context-mcp on this process, published as
# https://mcp.eko.in/context/mcp. Unset = the routes do not exist (kill switch).
# CONTEXT_BUNDLE_URL=https://eps.eko.in/agent/eps.json
# bundle re-validation window (seconds)
# CONTEXT_BUNDLE_TTL_SEC=900
