{
	"name": "ekoindia/eps-sdk",
	"description": "Backend-only PHP SDK for Eko Platform Services (EPS) APIs, with request signing built in.",
	"type": "library",
	"license": "MIT",
	"homepage": "https://eps.eko.in/docs",
	"keywords": ["eko", "eps", "aeps", "dmt", "bbps", "payments", "india", "sdk", "fintech"],
	"authors": [
		{
			"name": "Eko Bharat Ventures Pvt Ltd",
			"homepage": "https://eko.in"
		}
	],
	"support": {
		"docs": "https://eps.eko.in/docs",
		"issues": "https://github.com/ekoindia/eps-platform/issues",
		"source": "https://github.com/ekoindia/eps-platform/tree/main/packages/sdk-php"
	},
	"require": {
		"php": ">=8.1",
		"ext-curl": "*",
		"ext-json": "*"
	},
	"require-dev": {
		"phpunit/phpunit": "^10"
	},
	"autoload": {
		"psr-4": {
			"Eko\\Eps\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Eko\\Eps\\Tests\\": "tests/"
		}
	}
}
