{"nodes": [{"id": "docs_local_roadmap_api_sample_reconciliation_reconciliation", "label": "API sample-response reconciliation (before/after review)", "file_type": "document", "source_file": "docs/local-roadmap/api-sample-reconciliation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sampleSuccessResponse and responseData both feed code samples, .md twins, the agent bundle, fixtures and OpenAPI \u2014 so they must agree and are rewritten together per endpoint."}, {"id": "docs_local_roadmap_api_sample_reconciliation_no_live_values", "label": "Hard rule: adopt shape, never live values", "file_type": "rationale", "source_file": "docs/local-roadmap/api-sample-reconciliation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The source sheet holds real customer/prod data, so only key names, response_type_id and envelope are adopted; every value is reused or replaced with an obviously-fake placeholder, with a grep scan proving zero live values landed."}, {"id": "docs_local_roadmap_api_sample_reconciliation_bucket_a", "label": "Bucket A \u2014 REPLACE (39 endpoints rewritten from prod shape)", "file_type": "concept", "source_file": "docs/local-roadmap/api-sample-reconciliation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_local_roadmap_api_sample_reconciliation_bucket_b", "label": "Bucket B \u2014 KEEP + FLAG (suspect prod captures)", "file_type": "concept", "source_file": "docs/local-roadmap/api-sample-reconciliation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Captures that are timeouts, empty-list cases, mis-harvested rows or a KYC gate rather than the real endpoint response \u2014 flagged with TODO(reconcile) instead of overwriting a correct sample with a wrong one."}, {"id": "docs_local_roadmap_api_sample_reconciliation_type_inference_rules", "label": "responseData type-inference rules", "file_type": "rationale", "source_file": "docs/local-roadmap/api-sample-reconciliation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never infer from a single value blindly: Eko returns most numbers as quoted strings, nulls/empties stay strings, empty containers are described not fabricated, and unknown semantics get 'Returned by the API.' rather than invented behavior."}, {"id": "docs_local_roadmap_api_sample_reconciliation_sample_schema_parity_check", "label": "Sample\u2194schema parity automated check", "file_type": "concept", "source_file": "docs/local-roadmap/api-sample-reconciliation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Asserts sampleSuccessResponse.data keys match resolveResponseFields output and the generated OpenAPI example matches its response schema \u2014 catches drift across all bucket-A slugs at once."}], "edges": [{"source": "docs_local_roadmap_api_sample_reconciliation_reconciliation", "target": "docs_local_roadmap_api_sample_reconciliation_no_live_values", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/local-roadmap/api-sample-reconciliation.md", "source_location": null, "weight": 1.0}, {"source": "docs_local_roadmap_api_sample_reconciliation_reconciliation", "target": "docs_local_roadmap_api_sample_reconciliation_bucket_a", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/local-roadmap/api-sample-reconciliation.md", "source_location": null, "weight": 1.0}, {"source": "docs_local_roadmap_api_sample_reconciliation_reconciliation", "target": "docs_local_roadmap_api_sample_reconciliation_bucket_b", "relation": "references", "confidence": "EXTRACTED", "confidence_s