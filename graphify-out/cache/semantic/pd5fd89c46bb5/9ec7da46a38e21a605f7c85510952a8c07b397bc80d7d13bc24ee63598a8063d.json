{"nodes": [{"id": "docs_local_roadmap_sample_uidai_integration_testing_tool_rd_service_tool", "label": "Sample UIDAI RD-service integration testing tool (HTML)", "file_type": "document", "source_file": "docs/local-roadmap/sample-uidai-integration-testing-tool.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standalone jQuery/Bootstrap page that talks to a locally installed Aadhaar biometric RD service over custom HTTP verbs on 127.0.0.1 \u2014 the reference for how a browser reaches a fingerprint device."}, {"id": "docs_local_roadmap_sample_uidai_integration_testing_tool_discoveravdm", "label": "discoverAvdm() \u2014 RDSERVICE port scan 11100\u201311112", "file_type": "concept", "source_file": "docs/local-roadmap/sample-uidai-integration-testing-tool.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The RD service registers on an unpredictable local port, so discovery is a synchronous scan issuing the custom RDSERVICE verb until one responds; the scheme mirrors the page's own protocol."}, {"id": "docs_local_roadmap_sample_uidai_integration_testing_tool_captureavdm", "label": "CaptureAvdm() / deviceInfoAvdm() \u2014 PID capture + device info", "file_type": "concept", "source_file": "docs/local-roadmap/sample-uidai-integration-testing-tool.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses the discovered base URL plus a WADH value to request a signed PID block from the device; the response XML is what an AePS/eKYC call actually carries upstream."}], "edges": [{"source": "docs_local_roadmap_sample_uidai_integration_testing_tool_rd_service_tool", "target": "docs_local_roadmap_sample_uidai_integration_testing_tool_discoveravdm", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/local-roadmap/sample-u