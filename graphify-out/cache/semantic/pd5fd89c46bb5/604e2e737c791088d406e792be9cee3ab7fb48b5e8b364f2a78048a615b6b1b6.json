{"nodes": [{"id": "packages_eps_context_mcp_readme_eps_context_mcp", "label": "@ekoindia/eps-context-mcp (stdio documentation MCP server)", "file_type": "document", "source_file": "packages/eps-context-mcp/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full API bundle baked into the package so it works offline with no EPS account or credentials."}, {"id": "packages_eps_context_mcp_readme_tiered_lazy_tools", "label": "Tiered, lazy, secret-free tool design", "file_type": "rationale", "source_file": "packages/eps-context-mcp/README.md", "source_location": "lines 50-58", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Start with cheap compact list_apis/search, then call get_api only for the endpoints actually needed; same for topics and recipes. Keeps agent context small. Errors return isError with 'did you mean' suggestions."}, {"id": "packages_eps_context_mcp_readme_debug_auth", "label": "debug_auth tool (known-answer test vector)", "file_type": "concept", "source_file": "packages/eps-context-mcp/README.md", "source_location": "lines 210-227", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Secret-free by design, no access_key parameter ever: (1) the server is reachable anonymously over HTTP, so a key in a tool argument would travel to infrastructure that deliberately holds no secrets; (2) a tool argument lands in the caller's model context and transcript, teaching agents to read secrets out of env and paste them into chat. Instead it returns a dummy-key test vector plus ranked_causes for the 403."}, {"id": "packages_eps_context_mcp_readme_eps_bundle_url", "label": "EPS_BUNDLE_URL remote bundle override", "file_type": "concept", "source_file": "packages/eps-context-mcp/README.md", "source_location": "lines 170-189", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Remote fetch capped at 5 seconds with transparent fallback to the baked bundle; get_meta reports which source is in effect (baked or remote)."}, {"id": "packages_eps_context_mcp_readme_update_check", "label": "Best-effort npm update check", "file_type": "concept", "source_file": "packages/eps-context-mcp/README.md", "source_location": "lines 161-166", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One 3s-timeout registry request at startup, silent on any failure, never blocks startup; sets updateAvailable on get_meta so the agent can nudge the user. EPS_NO_UPDATE_CHECK=1 disables it entirely."}, {"id": "packages_eps_context_mcp_readme_backend_only_signing", "label": "Backend-only signing policy (context MCP)", "file_type": "rationale", "source_file": "packages/eps-context-mcp/README.md", "source_location": "lines 191-208", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "get_signing_snippet emits only an algorithm template that reads the key from process.env/getenv \u2014 it never embeds a real key. This server holds no credentials and performs no signing or API calls itself."}], "edges": [{"source": "packages_eps_context_mcp_readme_debug_auth", "target": "packages_eps_transact_mcp_readme_eps_transact_mcp", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/eps-context-mcp/README.md", "source_location": "lines 225-227", "weight": 1.0}, {"source": "packages_eps_context_mcp_readme_eps_context_mcp", "target": "packages_eps_context_mcp_readme_tiered_lazy_tools", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/eps-context-mcp/README.md", "source_location": "lines 8-11, 50-53", "weight": 1.0}, {"source": "packages_eps_context_mcp_readme_eps_context_mcp", "target": "packages_eps_context_mcp_readme_debug_auth", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/eps-context-mcp/README.md", "source_location": "line 48", "weight": 1.0}, {"source": "packages_eps_context_mcp_readme_eps_context_mcp", "target": "packages_eps_context_mcp_readme_eps_bundle_url", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/eps-context-mcp/README.md", "source_location": "lines 170-189", "weight": 1.0}, {"source": "packages_eps_context_mcp_readme_eps_context_mcp", "target": "packages_eps_context_mcp_readme_update_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/eps-context-mcp/README.md", "source_location": "lines 161-166", "weight": 1.0}, {"source": "packages_eps_context_mcp_readme_backend_only_signing", "target": "src_content_docs_how_auth_works_hmac_secret_key", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/eps-context-mcp/README.md", "source_location": "lines 193-197", "weight": 1.0}, {"source": "packages_eps_context_mcp_readme_debug_auth", "target": "src_content_docs_error_codes_403_forbidden", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/eps-context-mcp/README.md", "source_location": "lines 48, 221-225", "weight": 1.0}, {"source": "packages_eps_context_mcp_readme_backend_only_signing", "target": "packages_sdk_js_readme_epsclient", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "packages/eps-context-mcp/README.md", "source_location": "lines 199-208", "weight": 1.0}, {"source": "packages_eps_backend_docs_eps_backend_vercel_deploy_simplibank_ip_allowlist", "target": "packages_eps_context_mcp_readme_debug_auth", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "packages/eps-context-mcp/README.md", "source_location": "lines 221-225", "weight": 1.0}], "hyperedges": []}