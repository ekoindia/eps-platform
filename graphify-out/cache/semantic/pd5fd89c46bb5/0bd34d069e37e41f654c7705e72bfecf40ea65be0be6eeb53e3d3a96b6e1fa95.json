{"nodes": [{"id": "packages_eps_transact_mcp_readme_eps_transact_mcp", "label": "@ekoindia/eps-transact-mcp (transactional MCP server)", "file_type": "document", "source_file": "packages/eps-transact-mcp/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unlike eps-context-mcp (docs only), these tools actually call Eko, signed with real EPS credentials. Verification-category, non-financial endpoints only."}, {"id": "packages_eps_transact_mcp_readme_registry_driven_tools", "label": "Registry-driven tool generation from api-specs.ts", "file_type": "concept", "source_file": "packages/eps-transact-mcp/README.md", "source_location": "lines 5, 64", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every tool is generated from the same single source of truth (api-specs.ts \u2192 eps.json) as the docs, SDKs, and context MCP, so tool schemas can never drift from the published API surface."}, {"id": "packages_eps_transact_mcp_readme_x_eko_allowed_apis", "label": "X-Eko-Allowed-Apis scoping header", "file_type": "concept", "source_file": "packages/eps-transact-mcp/README.md", "source_location": "lines 27-34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately required because EPS calls are billed. It is a client-side guardrail out of the model's reach, NOT an authorization system \u2014 the Eko credentials remain the real boundary."}, {"id": "packages_eps_transact_mcp_readme_stateless_passthrough_signer", "label": "Stateless pass-through signer (no persistence, no body logging)", "file_type": "rationale", "source_file": "packages/eps-transact-mcp/README.md", "source_location": "lines 70-76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No database, cache, or session store; credentials exist only for the request lifetime. The access log records method/path/status/duration/request-id/tool name but never headers, tool arguments, or upstream responses, because verification traffic carries PAN/Aadhaar/bank data. Container binds loopback behind a reverse proxy."}, {"id": "packages_eps_transact_mcp_readme_mcp_annotations", "label": "MCP tool annotations for side-effecting verification tools", "file_type": "concept", "source_file": "packages/eps-transact-mcp/README.md", "source_location": "line 66", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "openWorldHint: true on all (paid external API); readOnlyHint/idempotentHint false on the genuinely side-effecting ones (\u20b91 penny-drop bank verification, bulk submits, OTP send/verify, DigiLocker consent URL) so hosts can gate them. Billing applies to all successful calls either way."}, {"id": "packages_eps_transact_mcp_readme_copied_utils_parity_test", "label": "parity.copied-utils.test.ts content-hash pin", "file_type": "concept", "source_file": "packages/eps-transact-mcp/README.md", "source_location": "line 89", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four utils (fetchTimeout, requestId, accessLog, update-check) are hand-copied from eps-backend / eps-context-mcp; a test pins a content hash of both sides of each pair so editing either file fails the suite until the pair is diffed and reconciled."}, {"id": "packages_eps_transact_mcp_readme_uat_smoke_test", "label": "Opt-in live UAT smoke test", "file_type": "concept", "source_file": "packages/eps-transact-mcp/README.md", "source_location": "lines 91-98", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Self-skips unless real UAT credentials are set. It is the only proof the bundle's environment URLs are live-correct, so it must run before any deploy that changes base URLs or signing."}], "edges": [{"source": "packages_eps_transact_mcp_readme_eps_transact_mcp", "target": "packages_eps_context_mcp_readme_eps_context_mcp", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/eps-transact-mcp/README.md", "source_location": "line 3", "weight": 1.0}, {"source": "packages_eps_transact_mcp_readme_eps_transact_mcp", "target": "packages_eps_transact_mcp_readme_registry_driven_tools", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/eps-transact-mcp/README.md", "source_location": "line 5", "weight": 1.0}, {"source": "packages_eps_transact_mcp_readme_eps_transact_mcp", "target": "packages_eps_transact_mcp_readme_x_eko_allowed_apis", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/eps-transact-mcp/README.md", "source_location": "lines 27-34", "weight": 1.0}, {"source": "packages_eps_transact_mcp_readme_eps_transact_mcp", "target": "packages_eps_transact_mcp_readme_stateless_passthrough_signer", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/eps-transact-mcp/README.md", "source_location": "lines 7, 70-76", "weight": 1.0}, {"source": "packages_eps_transact_mcp_readme_eps_transact_mcp", "target": "packages_eps_transact_mcp_readme_mcp_annotations", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/eps-transact-mcp/README.md", "source_location": "line 66", "weight": 1.0}, {"source": "packages_eps_transact_mcp_readme_copied_utils_parity_test", "target": "packages_eps_context_mcp_readme_update_check", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/eps-transact-mcp/README.md", "source_location": "line 89", "weight": 1.0}, {"source": "packages_eps_transact_mcp_readme_uat_smoke_test", "target": "packages_eps_transact_mcp_readme_eps_transact_mcp", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/eps-transact-mcp/README.md", "source_location": "lines 91-98", "weight": 1.0}, {"source": "packages_eps_transact_mcp_readme_eps_transact_mcp", "target": "packages_eps_transact_mcp_deploy_docker_compose_prod_transact_prod_stack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/eps-transact-mcp/README.md", "source_location": "lines 58, 100", "weight": 1.0}, {"source": "packages_eps_transact_mcp_readme_stateless_passthrough_signer", "target": "src_content_docs_how_auth_works_hmac_secret_key", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/eps-transact-mcp/README.md", "source_location": "line 26", "weight": 1.0}, {"source": "packages_eps_transact_mcp_readme_registry_driven_tools", "target": "packages_sdk_php_readme_sdk_surface_catalog", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "packages/eps-transact-mcp/README.md", "source_location": "line 5", "weight": 1.0}, {"source": "packages_eps_transact_mcp_readme_stateless_passthrough_signer", "target": "src_content_docs_aadhaar_biometric_rdservice_courier_not_consumer", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "packages/eps-transact-mcp/README.md", "source_location": "lines 70-76", "weight": 1.0}, {"source": "packages_eps_context_mcp_readme_update_check", "target": "packages_eps_transact_mcp_readme_eps_transact_mcp", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/eps-transact-mcp/README.md", "source_location": "line 60", "weight": 1.0}], "hyperedges": [{"id": "single_source_of_truth_api_surface", "label": "One API registry feeds docs, SDKs, and both MCP servers", "nodes": ["packages_eps_transact_mcp_readme_registry_driven_tools", "packages_eps_context_mcp_readme_eps_bundle_url", "packages_sdk_php_readme_sdk_surface_catalog", "packages_sdk_js_