{"nodes": [{"id": "docs_developer_docs_navigation_and_categories_docs_registry", "label": "docs-registry.ts (guides + endpoints unifier)", "file_type": "rationale", "source_file": "docs/developer-docs/navigation-and-categories.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Imports no React and no .mdx so ssg/routes.ts and unit tests can load it; URL model, slug guard, left menu and prerender list all come out of this one file."}, {"id": "docs_developer_docs_navigation_and_categories_flat_url_model", "label": "Flat /docs/<slug> URL model", "file_type": "rationale", "source_file": "docs/developer-docs/navigation-and-categories.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The HTTP method is kept out of the URL and surfaced via nav/detail method tags instead; guides and endpoints share one namespace."}, {"id": "docs_developer_docs_navigation_and_categories_buildnavtree", "label": "buildNavTree (left-menu categories)", "file_type": "concept", "source_file": "docs/developer-docs/navigation-and-categories.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_developer_docs_navigation_and_categories_getdocumentedspecs", "label": "getDocumentedSpecs", "file_type": "concept", "source_file": "docs/developer-docs/navigation-and-categories.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_developer_docs_navigation_and_categories_assertnoslugcollisions", "label": "assertNoSlugCollisions (module-load guard)", "file_type": "rationale", "source_file": "docs/developer-docs/navigation-and-categories.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs at module load and throws on duplicate or reserved slugs, so a bad slug fai