{"nodes": [{"id": "packages_eps_backend_docs_eps_backend_vercel_deploy_vercel_serverless_deploy", "label": "eps-backend on Vercel (managed serverless)", "file_type": "document", "source_file": "packages/eps-backend/docs/eps-backend-vercel-deploy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_eps_backend_docs_eps_backend_vercel_deploy_rejected_for_production", "label": "Vercel path rejected for production", "file_type": "rationale", "source_file": "packages/eps-backend/docs/eps-backend-vercel-deploy.md", "source_location": "lines 3-8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Production SimpliBank IP-allowlists clients; Vercel's egress IPs are dynamic, so this path would need the Static IPs add-on (~$100/mo/project), erasing its cost advantage. The serverless entry (api/index.ts, vercel.json) stays in the repo unused in case the allowlist constraint lifts."}, {"id": "packages_eps_backend_docs_eps_backend_vercel_deploy_buildapp_factory", "label": "buildApp side-effect-free factory", "file_type": "concept", "source_file": "packages/eps-backend/docs/eps-backend-vercel-deploy.md", "source_location": "line 18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "config \u2192 KV \u2192 clients \u2192 sessions \u2192 Hono app, shared by both the VM entry and the serverless entry so neither path forks the wiring."}, {"id": "packages_eps_backend_docs_eps_backend_vercel_deploy_first_party_session_cookies", "label": "First-party session cookies via backend subdomain", "file_type": "rationale", "source_file": "packages/eps-backend/docs/eps-backend-vercel-deploy.md", "source_location": "lines 44-49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A *.vercel.app backend is a different registrable domain from eps.eko.in, so default SameSite=Lax session cookies are not sent on cross-site XHR and auth silently breaks. Fix: host the backend on a subdomain of the frontend's domain (api.eps.eko.in). COOKIE_SAMESITE=None+Secure is the fragile alternative."}, {"id": "packages_eps_backend_docs_eps_backend_vercel_deploy_simplibank_ip_allowlist", "label": "SimpliBank IP allowlist constraint", "file_type": "concept", "source_file": "packages/eps-backend/docs/eps-backend-vercel-deploy.md", "source_location": "lines 56-58", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Public HTTPS solves reachability, not allowlisting. Production SimpliBank restricts client IPs, so dynamic serverless egress is blocked; a fixed/static outbound address is mandatory."}], "edges": [{"source": "packages_eps_backend_docs_eps_backend_vercel_deploy_vercel_serverless_deploy", "target": "packages_eps_backend_docs_eps_backend_vm_deploy_vm_deploy_runbook", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/eps-backend/docs/eps-backend-vercel-deploy.md", "source_location": "lines 6-10", "weight": 1.0}, {"source": "packages_eps_backend_docs_eps_backend_vercel_deploy_rejected_for_production", "target": "packages_eps_backend_docs_eps_backend_vercel_deploy_vercel_serverless_deploy", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/eps-backend/docs/eps-backend-vercel-deploy.md", "source_location": "lines 3-8", "weight": 1.0}, {"source": "packages_eps_backend_docs_eps_backend_vercel_deploy_simplibank_ip_allowlist", "target": "packages_eps_backend_docs_eps_backend_vercel_deploy_rejected_for_production", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/eps-backend/docs/eps-backend-vercel-deploy.md", "source_location": "lines 56-58", "weight": 1.0}, {"source": "packages_eps_backend_docs_eps_backend_vercel_deploy_vercel_serverless_deploy", "target": "packages_eps_backend_docs_eps_backend_vercel_deploy_buildapp_factory", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/eps-backend/docs/eps-backend-vercel-deploy.md", "source_location": "line 18", "weight": 1.0}, {"source": "packages_eps_backend_docs_eps_backend_vm_deploy_vm_deploy_runbook", "target": "packages_eps_backend_docs_eps_backend_vercel_deploy_buildapp_factory", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "packages/eps-backend/docs/eps-backend-vercel-deploy.md", "source_location": "line 19", "weight": 1.0}], "hyperedges": []}