{"nodes": [{"id": "docs_local_roadmap_temp2_free_vercel_backend_vercel_feasibility", "label": "eps-backend on Vercel Pro \u2014 feasibility + migration plan", "file_type": "document", "source_file": "docs/local-roadmap/\ud83d\udea9 TEMP2-free-vercel-backend.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At ~20 daily users the load is absorbed by the $20 seat credit (~100x headroom); Hobby is not an option because its ToS forbids commercial use. Vercel git-push deploy would retire the whole GHCR poller + docker-compose + rollback machinery."}, {"id": "docs_local_roadmap_temp2_free_vercel_backend_vpn_blocker", "label": "SimpliBank VPN egress blocker (resolved: prod is public HTTPS)", "file_type": "rationale", "source_file": "docs/local-roadmap/\ud83d\udea9 TEMP2-free-vercel-backend.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vercel functions egress to the public internet only; Static IPs only fix allowlisting, and real private peering is Enterprise-only. The decisive question was whether prod SimpliBank is public \u2014 it is, so the blocker is gone."}, {"id": "docs_local_roadmap_temp2_free_vercel_backend_upstash_redis", "label": "Upstash Redis (in-memory KV cannot survive serverless)", "file_type": "concept", "source_file": "docs/local-roadmap/\ud83d\udea9 TEMP2-free-vercel-backend.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each invocation is a fresh isolate; createRedisKV already accepts rediss:// so Upstash is a drop-in with no client rewrite. node-redis forces the Node runtime, not Edge."}, {"id": "docs_local_roadmap_temp2_free_vercel_backend_serverless_entry", "label": "buildApp() extraction + api/index.ts serverless entry", "file_type": "concept", "source_file": "docs/local-roadmap/\ud83d\udea9 TEMP2-free-vercel-backend.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reuses the existing createApp() factory so no HTTP layer is rewritten; memoized at module scope so warm invocations share one Redis connection. eps-backend is its own Vercel project \u2014 the repo-root vercel.json is the website."}], "edges": [{"source": "docs_local_roadmap_temp2_free_vercel_backend_vercel_feasibility", "target": "docs_local_roadmap_temp2_free_vercel_backend_vpn_blocker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/local-roadmap/\ud83d\udea9 TEMP2-free-vercel-backend.md", "source_location": null, "weight": 1.0}, {"source": "docs_local_roadmap_temp2_free_vercel_backend_vercel_feasibility", "target": "docs_local_roadmap_temp2_free_vercel_backend_upstash_redis", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/local-roadmap/\ud83d\udea9 TEMP2-free-vercel-backend.md", "source_location": null, "weight": 1.0}, {"source": "docs_local_roadmap_temp2_free_vercel_backend_vercel_feasibility", "target": "docs_local_roadmap_temp2_free_vercel_backend_serverless_entry", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/local-roadmap/\ud83d\udea9 TEMP2-free-vercel-backend.md", "source_location": null, "weight": 1.0}, {"source": "docs_local_roadmap_temp2_free_vercel_backend_vpn_blocker", "target": "docs_features_user_onboarding_connect_api_delegation", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/local-roadmap/\ud83d\udea9 TEMP2-free-vercel-backend.md", "source_location": null, "weight": 1.0}, {"source": "docs_local_roadmap_temp2_free_vercel_backend_vercel_feasibility", "target": "docs_local_roadmap_how_to_deploy_eps_transact_mcp_on_vm_poller", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/l