{"nodes": [{"id": "docs_developer_docs_layout_ssg_theming_docslayout", "label": "DocsLayout 3-pane grid", "file_type": "rationale", "source_file": "docs/developer-docs/layout-ssg-theming.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nav tree and theme toggle are injected as props/children rather than hard-wired, so guides render without a right pane and endpoints render with one."}, {"id": "docs_developer_docs_layout_ssg_theming_prerender_pipeline", "label": "SSG prerender pipeline (ssg/plugin.ts, prerender.ts)", "file_type": "concept", "source_file": "docs/developer-docs/layout-ssg-theming.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_developer_docs_layout_ssg_theming_route_chunk_map", "label": "ROUTE_CHUNK_MAP modulepreload", "file_type": "rationale", "source_file": "docs/developer-docs/layout-ssg-theming.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets the prerenderer preload the right page module per route, avoiding a bundle-to-chunk waterfall."}, {"id": "docs_developer_docs_layout_ssg_theming_docs_dark_theme", "label": "Docs-local dark theme (scoped .dark)", "file_type": "rationale", "source_file": "docs/developer-docs/layout-ssg-theming.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The .dark class is applied to the DocsLayout root, not <html>, so the rest of the site stays light; the server renders light mode and the client applies the saved theme after mount to avoid a hydration mismatch."}, {"id": "docs_developer_docs_layout_ssg_theming_theme_inline", "label": "@theme inline requirement", "file_type": "rationale", "source_file": "docs/developer-docs/layout-ssg-theming.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Load-bearing: it keeps semantic --color-* bindings live at use-site; without inline, Tailwind would bake the :root value at build time and the scoped .dark class would have no effect."}, {"id": "docs_developer_docs_layout_ssg_theming_scrollbars", "label": "Globally themed scrollbars", "file_type": "rationale", "source_file": "docs/developer-docs/layout-ssg-theming.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One declaration on --foreground tracks both themes; the WebKit pseudo-element block is gated behind @supports not (scrollbar-color: auto) so browsers supporting both do not style twice."}], "edges": [{"source": "docs_developer_docs_layout_ssg_theming_docslayout", "target": "docs_developer_docs_navigation_and_categories_docsnavtree", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/developer-docs/layout-ssg-theming.md", "source_location": null, "weight": 1.0}, {"source": "docs_developer_docs_layout_ssg_theming_prerender_pipeline", "target": "docs_developer_docs_navigation_and_categories_docs_registry", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/developer-docs/layout-ssg-theming.md", "source_location": null, "weight": 1.0}, {"source": "docs_developer_docs_layout_ssg_theming_prerender_pipeline", "target": "docs_developer_docs_layout_ssg_theming_route_chunk_map", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/developer-docs/layout-ssg-theming.md", "source_location": null, "weight": 1.0}, {"source": "docs_developer_docs_layout_ssg_theming_prerender_pipeline", "target": "readme_ssg_static_prerendering", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/developer-docs/layout-ssg-theming.md", "source_location": null, "weight": 1.0}, {"source": "docs_developer_docs_layout_ssg_theming_docs_dark_theme", "target": "docs_developer_docs_layout_ssg_theming_theme_inline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/developer-docs/layout-ssg-theming.md", "source_location": null, "weight": 1.0}, {"source": "docs_developer_docs_layout_ssg_theming_docs_dark_theme", "target": "docs_developer_docs_layout_ssg_theming_scrollbars", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/developer-docs/layout-ssg-theming.md", "source_location": null, "weight": 1.0}, {"source": "docs_developer_docs_layout_ssg_theming_scrollbars", "target": "docs_command_palette_search_command_palette", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/developer-docs/layout-ssg-theming.md", "source_location": null, "weight": 1.0}, {"source": "docs_developer_docs_layout_ssg_theming_route_chunk_map", "target": "docs_chunk_error_auto_reload_chunk_error_auto_reload", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/developer-docs/layout-ssg-theming.md", "source_location": null, "weight": 1.0}], "hyperedges": []}