{"nodes": [{"id": "docs_chunk_error_auto_reload_chunk_error_auto_reload", "label": "Stale-chunk auto-reload", "file_type": "rationale", "source_file": "docs/chunk-error-auto-reload.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A deploy landing between page load and the first click on a lazy route made the SPA rewrite return HTML for a missing chunk, so React.lazy threw and Suspense fallback null blanked the page."}, {"id": "docs_chunk_error_auto_reload_installchunkerrorreload", "label": "installChunkErrorReload / reloadOnceForStaleChunk", "file_type": "concept", "source_file": "docs/chunk-error-auto-reload.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A sessionStorage timestamp caps forced reloads at one per 30s so a genuinely broken deploy cannot loop."}, {"id": "docs_chunk_error_auto_reload_errorboundary", "label": "ErrorBoundary around routes", "file_type": "concept", "source_file": "docs/chunk-error-auto-reload.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_chunk_error_auto_reload_assets_rewrite_exclusion", "label": "/assets/* excluded from SPA-shell rewrite", "file_type": "rationale", "source_file": "docs/chunk-error-auto-reload.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Missing chunks must fail fast with a 404 instead of 200+HTML, which the browser rejects as a MIME-type error."}], "edges": [{"source": "docs_chunk_error_auto_reload_chunk_error_auto_reload", "target": "docs_chunk_error_auto_reload_installchunkerrorreload", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/chunk-error-auto-reload.md", "source_location": null, "weight": 1.0}, {"source": "docs_chunk_error_auto_reload_errorboundary", "target": "docs_