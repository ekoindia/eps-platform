{"nodes": [{"id": "docs_local_roadmap_ai_agent_platform_status_ai_native_agent_platform", "label": "AI-Native Agent Platform (feature/ai-native-agent-platform)", "file_type": "document", "source_file": "docs/local-roadmap/ai-agent-platform-status.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Status/handover report: 4 phases shipped, everything auto-generated from api-specs.ts; the repo became an npm-workspaces monorepo."}, {"id": "docs_local_roadmap_ai_agent_platform_status_eps_json_bundle", "label": "/agent/eps.json canonical bundle (Phase 0 spine)", "file_type": "concept", "source_file": "docs/local-roadmap/ai-agent-platform-status.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic (FNV-1a content hash, no Date) so downstream artifacts never re-read the source of truth; every artifact consumes the bundle instead."}, {"id": "docs_local_roadmap_ai_agent_platform_status_eps_context_mcp", "label": "@ekoindia/eps-context-mcp (local stdio MCP, 9 tiered tools)", "file_type": "concept", "source_file": "docs/local-roadmap/ai-agent-platform-status.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local rather than hosted because EPS only needs its own small static specs \u2014 zero hosting, zero secrets, zero ops. Named eps-context-mcp so `eps-mcp` stays reserved for a transactional server; tools are tiered so the agent fetches one API/topic, not the whole docs."}, {"id": "docs_local_roadmap_ai_agent_platform_status_eps_sdk", "label": "Backend-only signed SDKs (@ekoindia/eps-sdk, ekoindia/eps-sdk PHP)", "file_type": "concept", "source_file": "docs/local-roadmap/ai-agent-platform-status.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backend-only by design \u2014 secret-key/secret-key-timestamp must never be generated in a frontend app, so access_key is never exposed. HMAC baked in is what generic OpenAPI codegen gets wrong."}, {"id": "docs_local_roadmap_ai_agent_platform_status_eps_mock_server", "label": "@ekoindia/eps-mock-server (offline, recipe-aware)", "file_type": "concept", "source_file": "docs/local-roadmap/ai-agent-platform-status.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replays /agent/fixtures.json on :4010 so agents can develop and be evaluated without live calls; scenarios selected via ?eps_scenario=."}, {"id": "docs_local_roadmap_ai_agent_platform_status_claude_plugin_eps", "label": "packages/claude-plugin-eps (MCP + skills + /eps command)", "file_type": "concept", "source_file": "docs/local-roadmap/ai-agent-platform-status.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Claude Code installs plugins from a marketplace git repo, so the plugin needs .claude-plugin/marketplace.json hosted and the MCP published before /plugin install works."}, {"id": "docs_local_roadmap_ai_agent_platform_status_distribution_decision", "label": "Distribution decision: public npm + Packagist", "file_type": "rationale", "source_file": "docs/local-roadmap/ai-agent-platform-status.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The whole value proposition is one-command adoption; public registries deliver that. Monorepo stays, but Packagist reads composer.json from a repo root so the PHP SDK needs a subtree-split mirror."}, {"id": "docs_local_roadmap_ai_agent_platform_status_github_packages_rejected", "label": "GitHub Packages rejected for public distribution", "file_type": "rationale", "source_file": "docs/local-roadmap/ai-agent-platform-status.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "npm from GitHub Packages requires consumer-side auth + scoped .npmrc even for public installs, so `npx -y @ekoindia/eps-context-mcp` would not just work; and there is no Composer or Go module support at all."}, {"id": "docs_local_roadmap_ai_agent_platform_status_ai_route_rename", "label": "/agents \u2192 /ai route rename + marketing redesign", "file_type": "concept", "source_file": "docs/local-roadmap/ai-agent-platform-status.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The old page rendered inside LegalPageLayout (a v1 shortcut) and read as an unstyled index \u2014 functionally complete but useless as an adoption surface. Redesigned as a dedicated hero/install-matrix/artifact-grid page; /ai.md stays as the lean text twin."}, {"id": "docs_local_roadmap_ai_agent_platform_status_context_packs", "label": "Drop-in agent context packs (AGENTS.md, CLAUDE.md, .cursorrules, copilot-instructions.md)", "file_type": "concept", "source_file": "docs/local-roadmap/ai-agent-platform-status.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generated from one canonical body so every harness gets the same HMAC-signing guidance; ships in days and works in every harness that exists today."}], "edges": [{"source": "docs_local_roadmap_ai_agent_platform_status_ai_native_agent_platform", "target": "docs_local_roadmap_ai_agent_platform_status_eps_json_bundle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/local-roadmap/ai-agent-platform-status.md", "source_location": null, "weight": 1.0}, {"source": "docs_local_roadmap_ai_agent_platform_status_eps_context_mcp", "target": "docs_local_roadmap_ai_agent_platform_status_eps_json_bundle", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/local-roadmap/ai-agent-platform-status.md", "source_location": null, "weight": 1.0}, {"source": "docs_local_roadmap_ai_agent_platform_status_eps_sdk", "target": "docs_local_roadmap_ai_agent_platform_status_eps_json_bundle", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/local-roadmap/ai-agent-platform-status.md", "source_location": null, "weight": 1.0}, {"source": "docs_local_roadmap_ai_agent_platform_status_eps_mock_server", "target": "docs_local_roadmap_ai_agent_platform_status_eps_json_bundle", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/local-roadmap/ai-agent-platform-status.md", "source_location": null, "weight": 1.0}, {"source": "docs_local_roadmap_ai_agent_platform_status_claude_plugin_eps", "target": "docs_local_roadmap_ai_agent_platform_status_eps_context_mcp", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/local-roadmap/ai-agent-platform-status.md", "source_location": null, "weight": 1.0}, {"source": "docs_local_roadmap_ai_agent_platform_status_github_packages_rejected", "target": "docs_local_roadmap_ai_agent_platform_status_distribution_decision", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/local-roadmap/ai-agent-platform-status.md", "source_location": null, "weight": 1.0}, {"source": "docs_local_roadmap_ai_agent_platform_status_ai_route_rename", "target": "docs_local_roadmap_ai_agent_platform_status_context_packs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/local-roadmap/ai-agent-platform-status.md", "source_location": null, "weight": 1.0}, {"source": "docs_local_roadmap_ai_agent_platform_status_ai_native_agent_platform", "target": "docs_sdk_golden_vector_golden_vector", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/local-roadmap/ai-agent-p