{"nodes": [{"id": "packages_eps_transact_mcp_deploy_docker_compose_prod_transact_prod_stack", "label": "eps-transact-mcp standalone production compose stack", "file_type": "code", "source_file": "packages/eps-transact-mcp/deploy/docker-compose.prod.yml", "source_location": "lines 1-86", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deployable on its own host, independent of eps-backend; co-locating on the same VM works only as a SEPARATE compose project (ports 8788 vs 8787, separate networks) so the stacks share nothing."}, {"id": "packages_eps_transact_mcp_deploy_docker_compose_prod_shared_poller_image", "label": "Shared eps-poller image across stacks", "file_type": "concept", "source_file": "packages/eps-transact-mcp/deploy/docker-compose.prod.yml", "source_location": "lines 44-66", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same poll.sh as eps-backend, published as a shared image because a foreign VM has no repo checkout to build from. Configured per-stack via env; REDIS_REQUIRED=0 because transact has no Redis. Each stack still runs its own poller container for fault/HOLD isolation."}, {"id": "packages_eps_transact_mcp_deploy_docker_compose_prod_blast_radius_guard", "label": "Shared-VM blast-radius resource limits", "file_type": "rationale", "source_file": "packages/eps-transact-mcp/deploy/docker-compose.prod.yml", "source_location": "lines 21-25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "mem_limit 512m + cpus 1.0 so a leak or runaway OOM-kills only this container (dockerd restarts it) instead of taking the whole shared host down."}], "edges": [{"source": "packages_eps_transact_mcp_deploy_docker_compose_prod_transact_prod_stack", "target": "packages_eps_backend_docs_eps_backend_vm_deploy_vm_deploy_runbook", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/eps-transa