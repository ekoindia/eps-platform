{"nodes": [{"id": "src_content_docs_endpoints_aeps_fingpay_biometric_ekyc_biometric_ekyc", "label": "AePS Fingpay Biometric eKYC endpoint", "file_type": "document", "source_file": "src/content/docs/endpoints/aeps-fingpay-biometric-ekyc.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Final step of a one-time-per-agent eKYC flow (Send OTP \u2192 Verify OTP \u2192 Biometric). Distinct from the daily 2FA required once per calendar day before transacting."}, {"id": "src_content_docs_endpoints_aeps_fingpay_biometric_ekyc_aadhaar_rsa_encryption", "label": "RSA Aadhaar-number encryption scheme", "file_type": "concept", "source_file": "src/content/docs/endpoints/aeps-fingpay-biometric-ekyc.md", "source_location": "lines 6-34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Base64-decode the public key, RSA-encrypt the Aadhaar number, base64-encode the result. UAT and production public keys differ. The same encrypted-Aadhaar + PID XML format is used by all AePS transaction APIs."}, {"id": "src_content_docs_endpoints_aeps_fingpay_biometric_ekyc_ftype_2_npci", "label": "fType=2 per NPCI FIR-FMR single-PID-block guidance", "file_type": "rationale", "source_file": "src/content/docs/endpoints/aeps-fingpay-biometric-ekyc.md", "source_location": "lines 57-61", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Capture with fType=2, not 0. A subset of banks that have not completed FMR+FIR compliance still require fType=0, so the current bank list must be checked before going live."}], "edges": [{"source": "src_content_docs_endpoints_aeps_fingpay_biometric_ekyc_biometric_ekyc", "target": "src_content_docs_aadhaar_biometric_rdservice_rdservice_guide", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/docs/endpoints/aeps-fingpay-biometric-ekyc.md", "source_location": "lines 51-55", "weight": 1.0}, {"source": "src_content_docs_endpoints_aeps_fingpay_biometric_ekyc_biometric_ekyc", "target": "src_content_docs_aadhaar_biometric_rdservice_wadh", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/docs/endpoints/aeps-fingpay-biometric-ekyc.md", "source_location": "lines 63-76", "weight": 1.0}, {"source": "src_content_docs_endpoints_aeps_fingpay_biometric_ekyc_biometric_ekyc", "target": "src_content_docs_endpoints_aeps_fingpay_biometric_ekyc_aadhaar_rsa_encryption", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/content/docs/endpoints/aeps-fingpay-biometric-ekyc.md", "source_location": "lines 6-34", "weight": 1.0}], "hyperedges": []}