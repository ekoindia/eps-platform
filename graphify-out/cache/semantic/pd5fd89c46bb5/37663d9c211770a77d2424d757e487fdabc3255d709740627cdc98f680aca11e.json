{"nodes": [{"id": "docs_eps_transact_mcp_eps_transact_mcp", "label": "EPS transactional MCP server", "file_type": "document", "source_file": "docs/eps-transact-mcp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Executes verification APIs with the partner's own credentials for their production agents \u2014 deliberately not a coding-agent plugin and absent from the marketplace."}, {"id": "docs_eps_transact_mcp_tool_generation", "label": "Tool generation from the baked bundle (src/tools.ts)", "file_type": "rationale", "source_file": "docs/eps-transact-mcp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filters to verification and non-financial specs and emits one eps_<slug> tool each; editing api-specs.ts and rebuilding is all it takes to add a tool, and a startup assertion fails the build if a spec needs a header the executor cannot send."}, {"id": "docs_eps_transact_mcp_pass_through_credentials", "label": "Pass-through credential custody", "file_type": "rationale", "source_file": "docs/eps-transact-mcp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keys arrive as per-request headers, sign, and vanish with the request \u2014 nothing in KV or on disk, so leak blast radius is one request in memory."}, {"id": "docs_eps_transact_mcp_sanitizeerror", "label": "sanitizeError (PII-safe error curation)", "file_type": "rationale", "source_file": "docs/eps-transact-mcp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Upstream/network error text can echo request data (PAN/Aadhaar/bank), so it is replaced; only EpsClient validation messages naming params pass through, and the access log carries the tool name only."}, {"id": "docs_eps_transact_mcp_allowlist_header", "label": "X-Eko-Allowed-Apis tool scoping", "file_type": "rationale", "source_file": "docs/eps-transact-mcp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Voluntary scoping, not entitlement: it lives in partner-controlled client config out of the model's reach, but the Eko credentials remain the true authz boundary."}, {"id": "docs_eps_transact_mcp_rate_limiting", "label": "In-memory abuse throttling", "file_type": "rationale", "source_file": "docs/eps-transact-mcp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Best-effort fixed window (60/10min) keyed on env + hashed developer key; per-process and reset on restart \u2014 move to shared Redis KV if this ever runs multi-instance."}, {"id": "docs_eps_transact_mcp_stateless_http", "label": "Stateless streamable HTTP transport", "file_type": "rationale", "source_file": "docs/eps-transact-mcp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fresh transport per POST with no sessions and no GET/SSE stream (405, spec-legal), so initialize, tools/list and tools/call each stand alone."}, {"id": "docs_eps_transact_mcp_stdio_transport", "label": "Local stdio transport + startup update check", "file_type": "rationale", "source_file": "docs/eps-transact-mcp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the stdio bin does the npm latest check \u2014 remote users cannot self-update and stderr there is operator log noise."}, {"id": "docs_eps_transact_mcp_process_isolation", "label": "Separate container from eps-backend", "file_type": "rationale", "source_file": "docs/eps-transact-mcp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "eps-backend holds admin GitHub OAuth tokens with GitOps deploy rights; compose co-location is ops convenience, the container is the security boundary."}, {"id": "docs_eps_transact_mcp_reverse_proxy_namespacing", "label": "Path-namespaced nginx reverse proxy (/transact/, /context/ reserved)", "file_type": "rationale", "source_file": "docs/eps-transact-mcp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A trailing-slash proxy_pass strips the prefix so the app serves bare /mcp unchanged (safe because the transport emits no absolute URLs); the proxy must overwrite x-real-ip for the rate-limit fallback and disable request and response buffering."}, {"id": "docs_eps_transact_mcp_poller_auto_pull", "label": "Auto-pull poller (image digest watcher)", "file_type": "rationale", "source_file": "docs/eps-transact-mcp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retagging :prod on every green main plus a poller that recreates the service on a digest change makes 'update the tools' mean 'merge the spec change'; a distinct volume keeps its lock/HOLD state separate from the backend's."}, {"id": "docs_eps_transact_mcp_uat_smoke_test", "label": "Gated UAT smoke test (base URL + auth proof)", "file_type": "rationale", "source_file": "docs/eps-transact-mcp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Confirmed the portless environment URLs sign end-to-end; a failure means fixing meta.environments in the SSOT, never patching URLs in this package."}, {"id": "docs_eps_transact_mcp_vfs_storage_trap", "label": "Docker vfs storage-driver trap", "file_type": "rationale", "source_file": "docs/eps-transact-mcp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Under vfs every layer is copied in full, so an auto-redeploying stack fills the disk; the tell is 'no space left on device' while df shows free space. Switching to overlay2 orphans existing images, so save them first."}, {"id": "docs_eps_transact_mcp_parity_test", "label": "parity.sdk-surface test (eps.json vs sdk-surface skew guard)", "file_type": "concept", "source_file": "docs/eps-transact-mcp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_eps_transact_mcp_feature_flag", "label": "VITE_SHOW_TRANSACT_MCP marketing gate", "file_type": "rationale", "source_file": "docs/eps-transact-mcp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The /agents page, nav split, prerender, sitemap and llms.txt entry appear only once the flag is on \u2014 flip it only after production deploy and smoke test."}], "edges": [{"source": "docs_admin_console_persisted_admin_token_model", "target": "docs_eps_transact_mcp_process_isolation", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/eps-transact-mcp.md", "source_location": null, "weight": 1.0}, {"source": "docs_eps_transact_mcp_eps_transact_mcp", "target": "docs_eps_transact_mcp_tool_generation", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/eps-transact-mcp.md", "source_location": null, "weight": 1.0}, {"source": "docs_eps_transact_mcp_tool_generation", "target": "docs_ai_agent_platform_eps_json_bundle", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/eps-transact-mcp.md", "source_location": null, "weight": 1.0}, {"source": "docs_eps_transact_mcp_tool_generation", "target": "readme_eps_sdk_js", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/eps-transact-mcp.md", "source_location": null, "weight": 1.0}, {"source": "docs_eps_transact_mcp_parity_test", "target": "docs