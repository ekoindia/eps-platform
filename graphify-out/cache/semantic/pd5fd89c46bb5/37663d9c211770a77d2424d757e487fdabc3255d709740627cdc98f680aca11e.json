rce_file": "docs/eps-transact-mcp.md", "source_location": null, "weight": 1.0}, {"source": "docs_eps_transact_mcp_poller_auto_pull", "target": "docs_eps_transact_mcp_vfs_storage_trap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/eps-transact-mcp.md", "source_location": null, "weight": 1.0}, {"source": "docs_eps_transact_mcp_uat_smoke_test", "target": "docs_developer_docs_single_source_of_truth_api_environments", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/eps-transact-mcp.md", "source_location": null, "weight": 1.0}, {"source": "docs_eps_transact_mcp_eps_transact_mcp", "target": "docs_eps_transact_mcp_feature_flag", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/eps-transact-mcp.md", "source_location": null, "weight": 1.0}, {"source": "docs_eps_transact_mcp_eps_transact_mcp", "target": "readme_eps_transact_mcp_package", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/eps-transact-mcp.md", "source_location": null, "weight": 1.0}, {"source": "docs_eps_transact_mcp_tool_generation", "target": "readme_bake_all", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/eps-transact-mcp.md", "source_location": null, "weight": 1.0}, {"source": "docs_eps_transact_mcp_pass_through_credentials", "target": "docs_features_connect_widget_access_token_lite", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/eps-transact-mcp.md", "source_location": null, "weight": 1.0}, {"source": "docs_eps_transact_mcp_sanitizeerror", "target": "docs_features_business_dashboard_zero_versus_absent", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/eps-transact-mcp.md", "source_location": null, "weight": 1.0}], "hyperedges": 