{
	"redirects": [
		{
			"source": "/products/ppi-levin-api",
			"destination": "/products/ppi-api",
			"permanent": true
		},
		{
			"source": "/products/ppi-digikhata-api",
			"destination": "/products/ppi-api",
			"permanent": true
		},
		{
			"source": "/docs/dmt-sender-ekyc",
			"destination": "/docs/dmt-fino-sender-ekyc",
			"permanent": true
		},
		{
			"source": "/docs/dmt-validate-ekyc-otp",
			"destination": "/docs/dmt-fino-validate-ekyc-otp",
			"permanent": true
		},
		{
			"source": "/docs/aadhaar-dmt-fino-ekyc",
			"destination": "/docs/dmt-fino-sender-ekyc",
			"permanent": true
		},
		{
			"source": "/docs/aadhaar-dmt-fino-verify-otp",
			"destination": "/docs/dmt-fino-validate-ekyc-otp",
			"permanent": true
		},
		{
			"source": "/docs/aadhaar-number-encryption",
			"destination": "/docs/fingpay-aeps-aadhaar-encryption",
			"permanent": true
		},
		{
			"source": "/docs/aadhaar-number-encryption.md",
			"destination": "/docs/fingpay-aeps-aadhaar-encryption.md",
			"permanent": true
		},
		{
			"source": "/docs/quickstart",
			"destination": "/docs",
			"permanent": true
		},
		{
			"source": "/recipe/dmt-send-money",
			"destination": "/recipe/dmt-fino-send-money",
			"permanent": true
		},
		{
			"source": "/recipe/dmt-send-money.md",
			"destination": "/recipe/dmt-fino-send-money.md",
			"permanent": true
		}
	],
	"routes": [
		{
			"src": "/api/(.*)",
			"dest": "${EPS_BACKEND_ORIGIN}/$1",
			"env": ["EPS_BACKEND_ORIGIN"]
		}
	],
	"rewrites": [
		{
			"source": "/llms-full.txt",
			"destination": "/index.md"
		},
		{
			"source": "/((?!assets/|\\.well-known/|ai-sitemap\\.xml$).*)",
			"destination": "/__spa-fallback.html"
		}
	],
	"headers": [
		{
			"source": "/assets/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/(.*)\\.md",
			"headers": [
				{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
				{
					"key": "Cache-Control",
					"value": "public, max-age=300, must-revalidate"
				}
			]
		},
		{
			"source": "/:path((?!index\\.md$).*)\\.md",
			"headers": [
				{
					"key": "Link",
					"value": "<https://eps.eko.in/:path>; rel=\"canonical\""
				}
			]
		},
		{
			"source": "/index.md",
			"headers": [
				{ "key": "Link", "value": "<https://eps.eko.in/>; rel=\"canonical\"" }
			]
		},
		{
			"source": "/",
			"headers": [
				{
					"key": "Link",
					"value": "</index.md>; rel=\"alternate\"; type=\"text/markdown\""
				}
			]
		},
		{
			"source": "/:page(products|docs|recipe|pricing|faq|security|use-cases|ai|agents)",
			"headers": [
				{
					"key": "Link",
					"value": "</:page.md>; rel=\"alternate\"; type=\"text/markdown\""
				}
			]
		},
		{
			"source": "/:section(products|industries|solutions|docs|recipe)/:slug([^/.]+)",
			"headers": [
				{
					"key": "Link",
					"value": "</:section/:slug.md>; rel=\"alternate\"; type=\"text/markdown\""
				}
			]
		},
		{
			"source": "/docs/sdk/:lang([^/.]+)",
			"headers": [
				{
					"key": "Link",
					"value": "</docs/sdk/:lang.md>; rel=\"alternate\"; type=\"text/markdown\""
				}
			]
		},
		{
			"source": "/.well-known/api-catalog",
			"headers": [
				{ "key": "Content-Type", "value": "application/linkset+json" },
				{
					"key": "Cache-Control",
					"value": "public, max-age=3600, must-revalidate"
				}
			]
		},
		{
			"source": "/llms.txt",
			"headers": [
				{ "key": "Content-Type", "value": "text/plain; charset=utf-8" },
				{
					"key": "Cache-Control",
					"value": "public, max-age=300, must-revalidate"
				}
			]
		},
		{
			"source": "/samples/partner-agreement",
			"headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
		},
		{
			"source": "/samples/partner-agreement.md",
			"headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
		},
		{
			"source": "/console",
			"headers": [
				{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
			]
		},
		{
			"source": "/console/(.*)",
			"headers": [
				{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
			]
		},
		{
			"source": "/admin",
			"headers": [
				{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
			]
		},
		{
			"source": "/admin/(.*)",
			"headers": [
				{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
			]
		}
	]
}
